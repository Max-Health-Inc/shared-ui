{
  "name": "@max-health-inc/shared-ui",
  "version": "0.4.6",
  "type": "module",
  "license": "MIT",
  "description": "Shared React UI components, hooks, and utilities for SMART on FHIR healthcare apps",
  "repository": {
    "type": "git",
    "url": "https://github.com/Max-Health-Inc/shared-ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./theme.css": "./src/theme.css",
    "./scenes.css": "./src/scenes.css",
    "./vite": {
      "types": "./src/vite/service-worker.d.ts",
      "import": "./src/vite/service-worker.js"
    },
    "./i18n": {
      "import": "./src/i18n/index.ts",
      "types": "./src/i18n/index.ts"
    },
    "./src/*": "./src/*"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --outDir dist",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "i18next": "^26.0.0",
    "react-i18next": "^17.0.0",
    "i18next-browser-languagedetector": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "i18next": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    },
    "i18next-browser-languagedetector": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "brandc": "^0.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "radix-ui": "^1.4.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/bun": "^1.3.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "happy-dom": "^20.9.0",
    "i18next": "^26.0.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "react-i18next": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^4.5.0"
  }
}
