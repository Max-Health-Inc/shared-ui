# A GitHub Packages scope resolves to the owner hosting it, so each org needs its own line:
# @max-network -> max-network, @max-health-inc -> Max-Health-Inc. Without the second line
# @max-health-inc/config resolves against registry.npmjs.org and 404s.
@max-network:registry=https://npm.pkg.github.com
@max-health-inc:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
